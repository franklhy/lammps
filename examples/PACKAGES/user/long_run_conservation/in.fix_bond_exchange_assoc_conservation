# Long-run conservation test for fix bond/exchange/assoc.
#
# Run from the MC/test/long_run_conservation directory, e.g.
#   lmp -in in.fix_bond_exchange_assoc_conservation
#
# Four independent B/A_bound/A_free triplets are placed far apart.  In every
# triplet, the two possible B-A distances are both 1.0 and pair epsilon is zero,
# so accepted exchanges should only swap the A state labels and the dynamic bond
# endpoint.  The conserved quantities should remain
#
#   A_free atoms        = 4
#   A_bound atoms       = 4
#   dynamic B-A bonds   = 4
#
# throughout the run.

units           lj
atom_style      bond
boundary        p p p
atom_modify     map array

read_data       data.fix_bond_exchange_assoc_conservation

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 97531 mom yes rot no dist gaussian
timestep        0.0

variable        is_free atom type==2
variable        is_bound atom type==3
compute         nfree all reduce sum v_is_free
compute         nbound all reduce sum v_is_bound

compute         bondinfo all property/local btype batom1 batom2
compute         ndynamic all reduce sum c_bondinfo[1] inputs local

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 4 86420 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks no

thermo          1000
thermo_style    custom step c_nfree c_nbound c_ndynamic f_xchg f_xchg[1] &
                f_xchg[2] f_xchg[3] f_xchg[4] f_xchg[5] f_xchg[6] f_xchg[7]
thermo_modify   norm no

dump            states all custom 1000 dump.fix_bond_exchange_assoc_conservation &
                id type mol x y z
dump_modify     states sort id

dump            bonds all local 1000 dump.fix_bond_exchange_assoc_conservation.bonds &
                index c_bondinfo[1] c_bondinfo[2] c_bondinfo[3]

run             10000

write_data      data.fix_bond_exchange_assoc_conservation.after
