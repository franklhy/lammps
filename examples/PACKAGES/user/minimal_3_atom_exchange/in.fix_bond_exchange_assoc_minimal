# Minimal three-atom test for fix bond/exchange/assoc.
#
# Run from the LAMMPS src directory, e.g.
#   lmp -in MC/test/in.fix_bond_exchange_assoc_minimal
#
# Geometry:
#   atom 1 = B pivot
#   atom 2 = A_bound, initially bonded to B
#   atom 3 = A_free
# Old and new B-A distances are both 1.0, the harmonic bond equilibrium
# distance is 1.0, and LJ epsilon is zero.  Thus dU = 0 and pkin = 1 should
# accept every generated proposal.

units           lj
atom_style      bond
boundary        p p p
atom_modify     map array

read_data       data.fix_bond_exchange_assoc_minimal

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 24681357 mom yes rot no dist gaussian
timestep        0.0

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 1 987654 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks yes

thermo          1
thermo_style    custom step temp f_xchg f_xchg[1] f_xchg[2] f_xchg[3] &
                f_xchg[4] f_xchg[5] f_xchg[6] f_xchg[7] f_xchg[8]

dump            states all custom 1 dump.fix_bond_exchange_assoc_minimal id type mol x y z
dump_modify     states sort id

compute         bondinfo all property/local btype batom1 batom2
dump            bonds all local 1 dump.fix_bond_exchange_assoc_minimal.bonds &
                index c_bondinfo[1] c_bondinfo[2] c_bondinfo[3]

run             20

write_data      data.fix_bond_exchange_assoc_minimal.after
