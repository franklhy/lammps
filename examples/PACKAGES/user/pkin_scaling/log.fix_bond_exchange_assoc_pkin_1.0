  read_data CPU = 0.044 seconds

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        1        1       
  special bond factors coul:  0        1        1       
     1 = max # of 1-2 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.000 seconds

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 24681357 mom yes rot no dist gaussian
timestep        0.0

variable        pkin equal 1.0
variable        nsteps equal 100000
variable        accept_expected equal v_pkin*v_nsteps
variable        skip_expected equal (1.0-v_pkin)*v_nsteps

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 1 111001 0.8 1.2                 pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0                 defensive_checks no

thermo          10000
thermo_style    custom step v_pkin v_accept_expected v_skip_expected f_xchg                 f_xchg[1] f_xchg[2] f_xchg[3] f_xchg[7]

run             ${nsteps}
run             100000
