# Bond-energy acceptance test for fix bond/exchange/assoc.
#
# Run from the MC/test/bond_energy_acceptance directory, e.g.
#   lmp -in in.fix_bond_exchange_assoc_bond_energy
#
# Geometry:
#   atom 1 = B pivot
#   atom 2 = A_bound, initially bonded to B at r_old = 1.0
#   atom 3 = A_free, attacking atom at r_new = 1.1
#
# Pair epsilon is zero, so the exchange is controlled by the harmonic bond
# energy only.  With bond_coeff 1 30.0 1.0 and LAMMPS harmonic bond energy
# K*(r-r0)^2, the uphill move has
#
#   dU = 30.0*(1.1 - 1.0)^2 - 30.0*(1.0 - 1.0)^2 = 0.3
#
# For pkin = 1, the uphill acceptance probability is p = exp(-0.3/Tcurrent),
# while the downhill reverse move is accepted with probability 1.  In this
# fixed-geometry two-state system, the long-run cumulative acceptance ratio
# reported by f_xchg should approach 2*p/(1+p).  Individual accepted/rejected
# moves remain stochastic, so compare the final cumulative ratio, not a single
# one-step result.

units           lj
atom_style      bond
boundary        p p p
atom_modify     map array

read_data       data.fix_bond_exchange_assoc_bond_energy

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 1357911 mom yes rot no dist gaussian
timestep        0.0

compute         tmc all temp
variable        du equal 0.3
variable        p_uphill equal exp(-v_du/c_tmc)
variable        acc_expected equal 2.0*v_p_uphill/(1.0+v_p_uphill)

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 1 246802 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks yes
fix_modify      xchg temp tmc

thermo          1000
thermo_style    custom step c_tmc v_du v_p_uphill v_acc_expected f_xchg &
                f_xchg[1] f_xchg[2] f_xchg[3] f_xchg[4] f_xchg[5] f_xchg[6] &
                f_xchg[7] f_xchg[8]

dump            states all custom 1000 dump.fix_bond_exchange_assoc_bond_energy id type mol x y z
dump_modify     states sort id

compute         bondinfo all property/local btype batom1 batom2
dump            bonds all local 1000 dump.fix_bond_exchange_assoc_bond_energy.bonds &
                index c_bondinfo[1] c_bondinfo[2] c_bondinfo[3]

run             50000

write_data      data.fix_bond_exchange_assoc_bond_energy.after
