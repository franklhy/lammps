# Binary restart continuation test for fix bond/exchange/assoc.
#
# Run from the MC/test/restart_topology directory, e.g.
#   lmp -in in.fix_bond_exchange_assoc_restart_file
#
# This is the binary-restart counterpart to the write-data/read-data topology
# test.  Stage 1 runs exchanges and writes a restart file.  Stage 2 clears
# LAMMPS, reads the restart file, redefines the computes and fix, and continues.
# The restart file stores atom types, bonds, special lists, and standard
# lj/cut/harmonic force-field settings, but fixes and computes must be recreated.
# Conserved quantities should remain
#
#   A_free atoms        = 4
#   A_bound atoms       = 4
#   dynamic B-A bonds   = 4
#
# before and after read_restart.

log             log.fix_bond_exchange_assoc_restart_file

units           lj
atom_style      bond
boundary        p p p
atom_modify     map array

read_data       data.fix_bond_exchange_assoc_restart_topology

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 97531 mom yes rot no dist gaussian
timestep        0.0

variable        is_free atom type==2
variable        is_bound atom type==3
compute         nfree all reduce sum v_is_free
compute         nbound all reduce sum v_is_bound
compute         bondinfo all property/local btype batom1 batom2
compute         ndynamic all reduce sum c_bondinfo[1] inputs local

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 4 778899 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks yes

thermo          500
thermo_style    custom step c_nfree c_nbound c_ndynamic f_xchg f_xchg[1] &
                f_xchg[2] f_xchg[3] f_xchg[4] f_xchg[5] f_xchg[6] f_xchg[7]
thermo_modify   norm no

dump            states1 all custom 500 dump.fix_bond_exchange_assoc_restart_file.stage1 &
                id type mol x y z
dump_modify     states1 sort id
dump            bonds1 all local 500 dump.fix_bond_exchange_assoc_restart_file.stage1.bonds &
                index c_bondinfo[1] c_bondinfo[2] c_bondinfo[3]

run             2000

write_restart   restart.fix_bond_exchange_assoc_restart_file.stage1

clear

read_restart    restart.fix_bond_exchange_assoc_restart_file.stage1

timestep        0.0

variable        is_free atom type==2
variable        is_bound atom type==3
compute         nfree all reduce sum v_is_free
compute         nbound all reduce sum v_is_bound
compute         bondinfo all property/local btype batom1 batom2
compute         ndynamic all reduce sum c_bondinfo[1] inputs local

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 4 998877 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks yes

thermo          500
thermo_style    custom step c_nfree c_nbound c_ndynamic f_xchg f_xchg[1] &
                f_xchg[2] f_xchg[3] f_xchg[4] f_xchg[5] f_xchg[6] f_xchg[7]
thermo_modify   norm no

dump            states2 all custom 500 dump.fix_bond_exchange_assoc_restart_file.stage2 &
                id type mol x y z
dump_modify     states2 sort id
dump            bonds2 all local 500 dump.fix_bond_exchange_assoc_restart_file.stage2.bonds &
                index c_bondinfo[1] c_bondinfo[2] c_bondinfo[3]

run             2000

write_data      data.fix_bond_exchange_assoc_restart_file.after
