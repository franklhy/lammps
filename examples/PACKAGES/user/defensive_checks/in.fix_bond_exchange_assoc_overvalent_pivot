# Expected-failure defensive-check test: pivot B has two dynamic B-A bonds.
#
# Run from MC/test/defensive_checks:
#   lmp -in in.fix_bond_exchange_assoc_overvalent_pivot
#
# Expected error substring:
#   requires each pivot_type atom to have at most one dynamic B-A bond

log             log.fix_bond_exchange_assoc_overvalent_pivot

units           lj
atom_style      bond
boundary        p p p
atom_modify     map array

read_data       data.fix_bond_exchange_assoc_overvalent_pivot

pair_style      lj/cut 1.122462048
pair_coeff      * * 0.0 1.0 1.122462048

bond_style      harmonic
bond_coeff      1 30.0 1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 1.0 10021 mom yes rot no dist gaussian
timestep        0.0

fix             integ all nve
fix             xchg all bond/exchange/assoc 1 1 10022 0.8 1.2 &
                pivot_type 1 free_type 2 bound_type 3 bond_type 1 pkin 1.0 &
                defensive_checks yes

run             1
